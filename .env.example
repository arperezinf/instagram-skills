# -----------------------------------------------------------------
# Todas las variables de abajo son OPCIONALES.
# Las skills funcionan en modo solo borradores sin nada definido:
# escriben el caption, el gancho, los hashtags y el plan de slides
# para que publiques desde la app.
# Agrega PUBLORA_API_KEY para subir tu contenido y programar posts
# automáticamente.
# -----------------------------------------------------------------

# Clave de API de Publora - regístrate gratis en https://app.publora.com/signup
PUBLORA_API_KEY=sk_your_key_here

# ID de conexión de la plataforma Instagram (formato: instagram-11223344)
# Está en el panel de Publora: Channels y luego tu cuenta de Instagram.
# Copia el valor completo, incluido el prefijo instagram-.
# Instagram requiere una cuenta de Empresa o de Creador (las personales no son compatibles).
INSTAGRAM_PLATFORM_ID=instagram-your_id_here

# -----------------------------------------------------------------
# Token de Apify (opcional) - permite a ig-audience-insights leer qué
# circula bajo un hashtag y las estadísticas públicas de un perfil.
# Sin token, las skills te piden que pegues lo que ves en la app.
#
# Registro: https://console.apify.com/sign-up
# Token:    https://console.apify.com/settings/integrations
# -----------------------------------------------------------------
APIFY_TOKEN=apify_api_your_token_here

# -----------------------------------------------------------------
# Avanzado (Nivel 2): si construiste tu propio publicador con Claude Code o
# Codex (por ejemplo sobre la API Graph de Instagram), las skills invocan
# INSTAGRAM_SKILLS_CUSTOM_POSTER al aprobar. Por seguridad, esa variable
# se lee SOLO del entorno de ejecución, nunca de este archivo .env.
# -----------------------------------------------------------------
# INSTAGRAM_SKILLS_CUSTOM_POSTER=python /ruta/a/mi-publicador.py   (definir en el entorno, no aquí)

# -----------------------------------------------------------------
# Token de Pixfaro (opcional) - permite a las skills generar ilustraciones
# para los posts (imágenes de feed, slides de carrusel, tarjetas de cita) y
# adjuntarlas al publicar. Devuelve una URL alojada que pasa directo al
# contenido de Publora. La superposición exacta al píxel de texto y logo
# mantiene cada imagen dentro de la marca.
#
# Registro y documentación: https://pixfaro.com  (formato de clave: pf_live_...)
#
# Sin token, las skills redactan el prompt de la imagen y te piden que la
# generes y pegues la URL.
# -----------------------------------------------------------------
PIXFARO_TOKEN=pf_live_your_token_here
